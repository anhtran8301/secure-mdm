# Shared editor settings, see https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# Google Java Style (enforced by Spotless + Checkstyle in be/pom.xml)
[*.java]
max_line_length = 100

[*.{ts,tsx,js,jsx,mjs}]
max_line_length = 100

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

[*.{cmd,bat}]
end_of_line = crlf
