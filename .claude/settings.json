{
  "permissions": {
    "allow": [
      "Bash(./mvnw *)",
      "Bash(corepack yarn lint*)",
      "Bash(corepack yarn test*)",
      "Bash(corepack yarn build*)",
      "Bash(corepack yarn typecheck*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)"
    ],
    "deny": ["Read(./.local/**)", "Read(**/.env)", "Read(**/.env.*)"]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-ts.sh 2>/dev/null || true",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format-java.sh >/dev/null 2>&1 || true",
            "timeout": 180,
            "statusMessage": "Spotless: formatting changed Java"
          }
        ]
      }
    ]
  }
}
